    {"id": "G-1", "area": "routing", "summary": "Per-profile output caps disagree: agent routing plans 1000/3000/6000 tokens, the gateway defaults to 512/1024/2048 and caps at AI_GATEWAY_MAX_OUTPUT_TOKENS (4096)."},
    {"id": "G-2", "area": "budget", "summary": "Agent routing defaults token_budget to 6000 for non-inspect operations and escalates to quality above 6000, but the gateway rejects token_budget above AI_GATEWAY_MAX_TOKEN_BUDGET (default 4096) with HTTP 400."},
    {"id": "G-3", "area": "routing", "summary": "The subscription slot names a vendor model (gpt-5.6-luna-subscription) instead of a provider-neutral alias; gateway model IDs are only env-configured slots."},
    {"id": "G-4", "area": "redaction", "summary": "No content redaction before the hosted provider: emails, phone numbers and bare 'token:' values pass through; context_pack redaction covers only credential-shaped key=value, bearer and PEM."},
    {"id": "G-5", "area": "budget", "summary": "Budget guard and rate limiter are process-local (single replica); the in-process gateway (outside the hosted service) only enforces the monthly budget when LLM_LAB_MONTHLY_BUDGET_USD is set."},
    {"id": "G-6", "area": "evaluation", "summary": "Provider quality, p50/p95 latency and rate-card reconciliation are not evaluated; evaluation plan release recommendation is 'restrict' with human approvals pending."},
